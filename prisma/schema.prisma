// prisma/schema.prisma
// ScholarFlow Production Universal Database Schema (PostgreSQL & MySQL / MariaDB)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum BackendType {
  supabase
  express
}

enum SuggestionStatus {
  pending
  accepted
  rejected
}

model UserProfile {
  id           String     @id @default(uuid())
  email        String     @unique
  fullName     String?    @map("full_name")
  avatarUrl    String?    @map("avatar_url")
  role         Role       @default(user)
  planId       String     @default("free") @map("subscription_plan")
  aiTokensUsed Int        @default(0) @map("ai_tokens_used")
  aiMonthlyQuota Int      @default(50000) @map("ai_monthly_quota")
  aiQuotaResetAt DateTime? @map("ai_quota_reset_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  documents    DocumentEntry[]
  citations    CitationLibraryEntry[]
  aiGenerations AiGenerationEntry[]

  @@map("profiles")
}

model DocumentEntry {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  title        String     @default("Untitled Document")
  content      String     @db.Text
  settings     Json?
  sharedWith   Json?      @map("shared_with")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  user         UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestions  DocumentSuggestion[]
  comments     DocumentComment[]
  revisions    DocumentRevision[]

  @@index([userId])
  @@map("documents")
}

model DocumentSuggestion {
  id           String           @id @default(uuid())
  documentId   String           @map("document_id")
  userId       String           @map("user_id")
  originalText String           @map("original_text") @db.Text
  suggestedText String          @map("suggested_text") @db.Text
  status       SuggestionStatus @default(pending)
  createdAt    DateTime         @default(now()) @map("created_at")

  document     DocumentEntry    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_suggestions")
}

model DocumentComment {
  id           String        @id @default(uuid())
  documentId   String        @map("document_id")
  userId       String        @map("user_id")
  userName     String        @map("user_name")
  content      String        @db.Text
  createdAt    DateTime      @default(now()) @map("created_at")

  document     DocumentEntry @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_comments")
}

model DocumentRevision {
  id            String        @id @default(uuid())
  documentId    String        @map("document_id")
  userId        String        @map("user_id")
  title         String        @default("Untitled Document")
  content       String        @db.Text
  wordCount     Int           @default(0) @map("word_count")
  changeSummary String?       @map("change_summary")
  isAutoSaved   Boolean       @default(false) @map("is_auto_saved")
  createdAt     DateTime      @default(now()) @map("created_at")

  document      DocumentEntry @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt(sort: Desc)])
  @@map("document_revisions")
}

model CitationLibraryEntry {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  title        String
  authors      Json        // Array of author strings
  year         Int?
  journal      String?
  doi          String?
  url          String?
  abstract     String?     @db.Text
  citationKey  String?     @map("citation_key")
  createdAt    DateTime    @default(now()) @map("created_at")

  user         UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("citation_library")
}

model AiModelEntry {
  id           String   @id
  name         String
  modelId      String   @map("model_id")
  providerId   String?  @map("provider_id")
  isEnabled    Boolean  @default(true) @map("is_enabled")
  isPremium    Boolean  @default(false) @map("is_premium")
  providerType String?  @default("openrouter") @map("provider_type")
  baseUrl          String?  @map("base_url")
  customApiKey     String?  @map("custom_api_key")
  accessTier       String?  @default("free") @map("access_tier")
  workloadCategory String?  @default("all") @map("workload_category")
  displayOrder     Int?     @default(0) @map("display_order")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("ai_models")
}

model AiProviderEntry {
  id         String   @id
  name       String
  type       String   @default("custom_openai")
  baseUrl    String?  @map("base_url")
  apiKey     String?  @map("api_key")
  isBuiltIn  Boolean  @default(false) @map("is_built_in")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("ai_providers")
}

model PricingPlanEntry {
  id          String   @id
  name        String
  price       Float
  features    Json     // Array of feature strings
  isPopular   Boolean  @default(false) @map("is_popular")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("pricing_plans")
}

model PaymentGatewayEntry {
  id          String   @id
  name        String
  isEnabled   Boolean  @default(true) @map("is_enabled")
  config      Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("payment_gateways")
}

model CitationCacheEntry {
  id          String   @id @default(uuid())
  queryKey    String   @unique @map("query_key")
  results     Json
  hitCount    Int      @default(1) @map("hit_count")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("citation_cache")
}

model InstitutionEntry {
  id               String    @id @default(uuid())
  name             String
  adminEmail       String    @map("admin_email")
  domains          Json      @default("[]")
  totalSeats       Int       @default(50) @map("total_seats")
  usedSeats        Int       @default(0) @map("used_seats")
  joinToken        String?   @unique @map("join_token")
  departmentQuotas Json?     @map("department_quotas")
  aiPolicy         Json?     @map("ai_policy")
  contractStart    DateTime  @default(now()) @map("contract_start")
  contractEnd      DateTime  @map("contract_end")
  status           String    @default("active")
  campusTextKey    String?   @map("campus_text_key")
  campusVisionKey  String?   @map("campus_vision_key")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("institutions")
}

model InstitutionMemberEntry {
  id             String    @id @default(uuid())
  institutionId  String    @map("institution_id")
  userId         String?   @map("user_id")
  name           String
  email          String
  role           String    @default("Student")
  department     String?   @default("Akademik Umum")
  aiQuotaUsed    Int       @default(0) @map("ai_quota_used")
  aiQuotaLimit   Int       @default(100000) @map("ai_quota_limit")
  graduationDate DateTime? @map("graduation_date")
  status         String    @default("Active")
  joined         DateTime  @default(now())
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("institution_members")
}

model InstitutionAuditLogEntry {
  id            String    @id @default(uuid())
  institutionId String    @map("institution_id")
  actorEmail    String    @map("actor_email")
  action        String
  target        String
  ipAddress     String?   @default("Browser") @map("ip_address")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("institution_audit_logs")
}

model AiGenerationEntry {
  id             String       @id @default(uuid())
  userId         String       @map("user_id")
  documentId     String?      @map("document_id")
  featureType    String       @default("improve") @map("feature_type")
  originalText   String?      @map("original_text") @db.Text
  resultText     String?      @map("result_text") @db.Text
  tone           String?      @default("academic")
  model          String?      @default("gemini")
  tokensConsumed Int          @default(0) @map("tokens_consumed")
  status         String       @default("completed")
  errorMessage   String?      @map("error_message")
  metadata       Json?        @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")

  user           UserProfile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("ai_generations")
}


