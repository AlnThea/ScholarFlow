// prisma/schema.prisma
// ScholarFlow Production Universal Database Schema (PostgreSQL & MySQL / MariaDB)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum BackendType {
  supabase
  express
}

enum SuggestionStatus {
  pending
  accepted
  rejected
}

model UserProfile {
  id           String     @id @default(uuid())
  email        String     @unique
  fullName     String?    @map("full_name")
  avatarUrl    String?    @map("avatar_url")
  role         Role       @default(user)
  planId       String     @default("free") @map("plan_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  documents    DocumentEntry[]
  citations    CitationLibraryEntry[]

  @@map("profiles")
}

model DocumentEntry {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  title        String     @default("Untitled Document")
  content      String     @db.Text
  settings     Json?
  sharedWith   Json?      @map("shared_with")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  user         UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestions  DocumentSuggestion[]
  comments     DocumentComment[]

  @@index([userId])
  @@map("documents")
}

model DocumentSuggestion {
  id           String           @id @default(uuid())
  documentId   String           @map("document_id")
  userId       String           @map("user_id")
  originalText String           @map("original_text") @db.Text
  suggestedText String          @map("suggested_text") @db.Text
  status       SuggestionStatus @default(pending)
  createdAt    DateTime         @default(now()) @map("created_at")

  document     DocumentEntry    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_suggestions")
}

model DocumentComment {
  id           String        @id @default(uuid())
  documentId   String        @map("document_id")
  userId       String        @map("user_id")
  userName     String        @map("user_name")
  content      String        @db.Text
  createdAt    DateTime      @default(now()) @map("created_at")

  document     DocumentEntry @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_comments")
}

model CitationLibraryEntry {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  title        String
  authors      Json        // Array of author strings
  year         Int?
  journal      String?
  doi          String?
  url          String?
  abstract     String?     @db.Text
  citationKey  String?     @map("citation_key")
  createdAt    DateTime    @default(now()) @map("created_at")

  user         UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("citation_library")
}

model AiModelEntry {
  id          String   @id
  name        String
  modelId     String   @map("model_id")
  isEnabled   Boolean  @default(true) @map("is_enabled")
  isPremium   Boolean  @default(false) @map("is_premium")
  provider    String   @default("gemini")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("ai_models")
}

model PricingPlanEntry {
  id          String   @id
  name        String
  price       Float
  features    Json     // Array of feature strings
  isPopular   Boolean  @default(false) @map("is_popular")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("pricing_plans")
}

model PaymentGatewayEntry {
  id          String   @id
  name        String
  isEnabled   Boolean  @default(true) @map("is_enabled")
  config      Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("payment_gateways")
}

model CitationCacheEntry {
  id          String   @id @default(uuid())
  queryKey    String   @unique @map("query_key")
  results     Json
  hitCount    Int      @default(1) @map("hit_count")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("citation_cache")
}
