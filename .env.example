# ============================================================
# ScholarFlow — Environment Variables
# ============================================================

# App
NEXT_PUBLIC_APP_NAME=ScholarFlow

# ============================================================
# Supabase
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://<your‑project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your‑anon‑key>

# Service Role Key — untuk server-side saja, JANGAN expose ke frontend
SUPABASE_SERVICE_KEY=<your‑secret-role‑key>

# ============================================================
# External APIs (dipakai di Next.js API routes)
# ============================================================
OPENALEX_API_BASE=https://api.openalex.org/works
CROSSREF_API_BASE=https://api.crossref.org/works
CROSSREF_MAILTO=

# ============================================================
# AI — Gemini
# ============================================================
GEMINI_API_KEY=<your‑gemini-key>
GEMINI_MODEL=gemini-flash-latest

# ============================================================
# AI — OpenRouter (Optional for Multi-Model Support)
# ============================================================
OPENROUTER_API_KEY=<your-openrouter-key>


# ============================================================
# Payment Gateways (Stripe & Midtrans)
# ============================================================
# Stripe Config
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Midtrans Config
MIDTRANS_MERCHANT_ID=G...
MIDTRANS_CLIENT_KEY=SB-Mid-client-...
MIDTRANS_SERVER_KEY=SB-Mid-server-...
MIDTRANS_IS_PRODUCTION=false

