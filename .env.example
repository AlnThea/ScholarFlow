# ============================================================
# ScholarFlow — Environment Variables (.env.local)
# ============================================================

# App Configuration
NEXT_PUBLIC_APP_NAME=ScholarFlow

# Environment Mode ('development' | 'staging' | 'production') — APP_ENV Equivalent
NEXT_PUBLIC_APP_ENV=development


# ============================================================
# 🔌 BACKEND SELECTION MODE
# ============================================================
# Pilih salah satu backend mode: 'supabase' ATAU 'express'
NEXT_PUBLIC_BACKEND_TYPE=supabase

# ------------------------------------------------------------
# [OPSI A] DIBUTUHKAN JIKA NEXT_PUBLIC_BACKEND_TYPE=supabase
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<your‑project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your‑anon‑key>

# Service Role Key — Digunakan khusus di server-side (API Routes), JANGAN expose ke client/frontend
SUPABASE_SERVICE_KEY=<your‑secret-role‑key>

# ------------------------------------------------------------
# [OPSI B] DIBUTUHKAN JIKA NEXT_PUBLIC_BACKEND_TYPE=express
# ------------------------------------------------------------
# URL Endpoint REST API Express.js (Self-Hosted VPS / Docker)
NEXT_PUBLIC_EXPRESS_API_URL=http://localhost:5000/api/v1

# ============================================================
# 📚 EXTERNAL ACADEMIC APIS (Kutipan & Pencarian Jurnal)
# ============================================================
OPENALEX_API_BASE=https://api.openalex.org/works
CROSSREF_API_BASE=https://api.crossref.org/works
CROSSREF_MAILTO=

# ============================================================
# 🧠 AI ENGINE — MULTI-TENANT & WORKLOAD-ISOLATED KEY POOLS
# Catatan: Variabel di bawah bersifat OPSIONAL jika API Key sudah
# dikonfigurasi melalui menu Dashboard Admin (Manage AI Models)
# atau Portal Kampus (Settings). Digunakan sebagai fallback server.
# ============================================================
# 1. General Fallback Keys (Baseline jika pool spesifik kosong)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. Pool Free Tier: Terpisah antara Teks dan Gambar (Rotasi Multi-Key GCP)
# Kunci khusus penulisan, parafrase, tata bahasa, dan abstrak (15 RPM/key):
GEMINI_FREE_TEXT_KEYS=
# Kunci khusus analisis gambar/multimodal SPSS, PSPP, SmartPLS, OCR (15 RPM/key):
GEMINI_FREE_VISION_KEYS=

# 3. Pool Pro Writer: Jalur berbayar / High Throughput (1000+ RPM)
GEMINI_PRO_TEXT_KEYS=
GEMINI_PRO_VISION_KEYS=
GEMINI_PRO_KEYS=

# 4. Pool Dedicated Kampus / Institusi B2B (Enterprise License)
GEMINI_INSTITUTION_TEXT_KEYS=
GEMINI_INSTITUTION_VISION_KEYS=
GEMINI_INSTITUTION_KEYS=

# 5. Multi-Model Providers (Direct & Aggregator)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ============================================================
# 💳 PAYMENT GATEWAYS (Stripe & Midtrans)
# ============================================================
# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Midtrans Configuration
MIDTRANS_MERCHANT_ID=G...
MIDTRANS_CLIENT_KEY=SB-Mid-client-...
MIDTRANS_SERVER_KEY=SB-Mid-server-...
MIDTRANS_IS_PRODUCTION=false

# Xendit Configuration
XENDIT_SECRET_KEY=A...
XENDIT_WEBHOOK_VERIFICATION_TOKEN=abc...
