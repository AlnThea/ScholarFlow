# ============================================================
# ScholarFlow — Environment Variables (.env.local)
# ============================================================

# App Configuration
NEXT_PUBLIC_APP_NAME=ScholarFlow

# Environment Mode ('development' | 'staging' | 'production') — APP_ENV Equivalent
NEXT_PUBLIC_APP_ENV=development


# ============================================================
# 🔌 BACKEND SELECTION MODE
# ============================================================
# Pilih salah satu backend mode: 'supabase' ATAU 'express'
NEXT_PUBLIC_BACKEND_TYPE=supabase

# ------------------------------------------------------------
# [OPSI A] DIBUTUHKAN JIKA NEXT_PUBLIC_BACKEND_TYPE=supabase
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<your‑project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your‑anon‑key>

# Service Role Key — Digunakan khusus di server-side (API Routes), JANGAN expose ke client/frontend
SUPABASE_SERVICE_KEY=<your‑secret-role‑key>

# ------------------------------------------------------------
# [OPSI B] DIBUTUHKAN JIKA NEXT_PUBLIC_BACKEND_TYPE=express
# ------------------------------------------------------------
# URL Endpoint REST API Express.js (Self-Hosted VPS / Docker)
NEXT_PUBLIC_EXPRESS_API_URL=http://localhost:5000/api/v1

# ============================================================
# 📚 EXTERNAL ACADEMIC APIS (Kutipan & Pencarian Jurnal)
# ============================================================
OPENALEX_API_BASE=https://api.openalex.org/works
CROSSREF_API_BASE=https://api.crossref.org/works
CROSSREF_MAILTO=

# ============================================================
# 🧠 AI ENGINE — MULTI-TENANT & WORKLOAD-ISOLATED KEY POOLS
# ============================================================
# 1. General Fallback Keys (dipakai jika pool spesifik di bawah tidak diisi)
GEMINI_API_KEY=<your‑gemini-key>,<your‑gemini-key>,<your‑gemini-key>
GEMINI_MODEL=gemini-1.5-flash

# 2. Pool A: Khusus Teks Ringan (Parafrase, Grammar, Abstrak, Burstiness)
# Pisahkan project GCP agar mendapat kuota gratis 15 RPM tersendiri tanpa bentrok dengan gambar
GEMINI_FREE_TEXT_KEYS=<key-gcp-project-text-1>,<key-gcp-project-text-2>

# 3. Pool B: Khusus Multimodal / Vision (Scan Gambar Tabel SPSS, PSPP, SmartPLS, OCR)
# Pisahkan project GCP agar proses screenshot gambar tidak membuat antrean teks macet
GEMINI_FREE_VISION_KEYS=<key-gcp-project-vision-1>,<key-gcp-project-vision-2>

# 4. Pool C: Jalur Cepat Member Pro (High Throughput / Paid Tier 1000+ RPM)
GEMINI_PRO_KEYS=<your-gemini-pro-paid-key>

# 5. Pool D: Jalur Dedicated Kampus / Institusi B2B (Managed AI Enterprise)
GEMINI_INSTITUTION_KEYS=<your-gemini-enterprise-campus-key>

# 6. Multi-Model Provider (Claude 3.5 Sonnet, GPT-4o Omni via OpenRouter)
OPENROUTER_API_KEY=<your-openrouter-key>

# ============================================================
# 💳 PAYMENT GATEWAYS (Stripe & Midtrans)
# ============================================================
# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Midtrans Configuration
MIDTRANS_MERCHANT_ID=G...
MIDTRANS_CLIENT_KEY=SB-Mid-client-...
MIDTRANS_SERVER_KEY=SB-Mid-server-...
MIDTRANS_IS_PRODUCTION=false

# Xendit Configuration
XENDIT_SECRET_KEY=A...
XENDIT_WEBHOOK_VERIFICATION_TOKEN=abc...
