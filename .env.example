# ============================================================
# ScholarFlow — Environment Variables (.env.local)
# ============================================================

# App Configuration
NEXT_PUBLIC_APP_NAME=ScholarFlow

# Environment Mode ('development' | 'staging' | 'production') — APP_ENV Equivalent
NEXT_PUBLIC_APP_ENV=development


# ============================================================
# 🔌 BACKEND SELECTION MODE
# ============================================================
# Pilih salah satu backend mode: 'supabase' ATAU 'express'
NEXT_PUBLIC_BACKEND_TYPE=supabase

# ------------------------------------------------------------
# [OPSI A] DIBUTUHKAN JIKA NEXT_PUBLIC_BACKEND_TYPE=supabase
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<your‑project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your‑anon‑key>

# Service Role Key — Digunakan khusus di server-side (API Routes), JANGAN expose ke client/frontend
SUPABASE_SERVICE_KEY=<your‑secret-role‑key>

# ------------------------------------------------------------
# [OPSI B] DIBUTUHKAN JIKA NEXT_PUBLIC_BACKEND_TYPE=express
# ------------------------------------------------------------
# URL Endpoint REST API Express.js (Self-Hosted VPS / Docker)
NEXT_PUBLIC_EXPRESS_API_URL=http://localhost:5000/api/v1

# ============================================================
# 📚 EXTERNAL ACADEMIC APIS (Kutipan & Pencarian Jurnal)
# ============================================================
OPENALEX_API_BASE=https://api.openalex.org/works
CROSSREF_API_BASE=https://api.crossref.org/works
CROSSREF_MAILTO=

# ============================================================
# 🧠 AI ENGINE — GOOGLE GEMINI
# ============================================================
GEMINI_API_KEY=<your‑gemini-key>,<your‑gemini-key>,<your‑gemini-key>,andmore
GEMINI_MODEL=gemini-flash-latest

# Optional: OpenRouter (Jika menggunakan Multi-Model Support)
OPENROUTER_API_KEY=<your-openrouter-key>

# ============================================================
# 💳 PAYMENT GATEWAYS (Stripe & Midtrans)
# ============================================================
# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Midtrans Configuration
MIDTRANS_MERCHANT_ID=G...
MIDTRANS_CLIENT_KEY=SB-Mid-client-...
MIDTRANS_SERVER_KEY=SB-Mid-server-...
MIDTRANS_IS_PRODUCTION=false
